# Copy this file to keystore.properties (which is gitignored) and fill in
# the real values. Never commit keystore.properties or the .jks/.keystore
# file itself — losing or leaking this key means you can never publish an
# update to the same Play Store listing again.
storeFile=/absolute/path/to/rug-player-upload.jks
storePassword=REPLACE_ME
keyAlias=rug-player-upload
keyPassword=REPLACE_ME
