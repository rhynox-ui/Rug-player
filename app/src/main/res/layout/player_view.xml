<?xml version="1.0" encoding="utf-8"?>
<!--
  Instantiated only to get a PlayerView backed by a TextureView instead of
  the default SurfaceView. A SurfaceView composites on its own hardware
  layer, which renders behind the rest of the Compose UI (gesture overlay,
  controls, the black background box) — audio plays but the picture never
  shows. TextureView draws as a normal view and composites correctly.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false" />
