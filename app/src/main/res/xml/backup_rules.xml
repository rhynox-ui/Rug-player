<?xml version="1.0" encoding="utf-8"?>
<!--
   Rug Player keeps everything on-device: only playback positions and app
   settings are ever persisted, and neither leaves the device via backup.
-->
<full-backup-content>
    <exclude domain="database" path="rug-player.db" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
